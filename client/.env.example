# Copy to client/.env.local. Everything is optional: without Stripe keys the
# checkout runs in demo mode and no real payment is taken.

# Real card payments (also run the server in /server)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_...
REACT_APP_PAYMENT_API_URL=http://localhost:4242

# Order confirmation emails (defaults to the team's EmailJS account)
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# Firebase project (defaults to ecommerce-jewlery)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_PROJECT_ID=
